<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>facebook_downloader</RootNamespace>

    <PackageId>fb-dl</PackageId>
    <Version>2.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fb-dl</ToolCommandName>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <Authors>Ali Mashally</Authors>
    <Description>Download public Facebook videos and reels with automatic quality selection, parallel downloads, and verified resume.</Description>
    <PackageTags>video downloader; facebook; fb-dl</PackageTags>
    <PackageProjectUrl>https://github.com/blackaly/fb-dl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blackaly/fb-dl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      .NET 10; parallel downloads; verified resume; automatic quality selection;
      improved extraction, media validation, retries, speed and ETA reporting.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="fb-dl.Tests" />
    <InternalsVisibleTo Include="fb-dl.Benchmark" />
  </ItemGroup>
</Project>
